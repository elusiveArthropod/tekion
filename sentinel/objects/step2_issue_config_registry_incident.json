{"steps":[
{"tool":"create_object","args":{"name":"Sentinel Issue","id":"sentinel_issue","pluralName":"Sentinel Issues","tags":["alert-monitoring"],
 "description":"One row per distinct failure (fingerprint = automation + node + error class + normalised message). The unit Sentinel reasons about and the Slack thread hangs off.",
 "fields":{
  "fingerprint":{"type":"string","title":"Fingerprint"},
  "automationId":{"type":"string","title":"Automation Id"},
  "automationName":{"type":"string","title":"Automation Name"},
  "nodeId":{"type":"string","title":"Node Id"},
  "exceptionClass":{"type":"string","title":"Exception Class"},
  "errorClass":{"type":"string","title":"Error Class","enum":["infra","auth","rate_limit","connector","app","unknown"]},
  "sampleErrorMessage":{"type":"string","title":"Sample Error Message"},
  "state":{"type":"string","title":"State","enum":["new","pending_agent","triaging","tracked","suppressed","escalated","resolved","reopened"]},
  "severity":{"type":"string","title":"Severity","enum":["low","medium","high","critical"]},
  "escalationLevel":{"type":"string","title":"Escalation Level"},
  "firstSeen":{"type":"integer","title":"First Seen (epoch ms)"},
  "lastSeen":{"type":"integer","title":"Last Seen (epoch ms)"},
  "totalCount":{"type":"integer","title":"Total Count"},
  "countSinceLastAck":{"type":"integer","title":"Count Since Last Answer"},
  "lastAckAt":{"type":"integer","title":"Last Answer At"},
  "lastAckBy":{"type":"string","title":"Last Answer By"},
  "parentIssueId":{"type":"string","title":"Parent Issue Id (cascade root)"},
  "incidentId":{"type":"string","title":"Incident Id"},
  "ownerUserId":{"type":"string","title":"Owner User Id"},
  "ownerSlackId":{"type":"string","title":"Owner Slack Id"},
  "slackChannelId":{"type":"string","title":"Slack Channel Id"},
  "slackRootTs":{"type":"string","title":"Slack Thread Ts"},
  "slackPermalink":{"type":"string","title":"Slack Permalink"},
  "reopenCount":{"type":"integer","title":"Reopen Count"},
  "suppressionType":{"type":"string","title":"Suppression Type"},
  "suppressedUntil":{"type":"integer","title":"Suppressed Until (epoch ms)"},
  "lastExecutionId":{"type":"string","title":"Last Execution Id"},
  "lastRunUrl":{"type":"string","title":"Last Run URL"},
  "needsPost":{"type":"boolean","title":"Needs Slack Post"},
  "postKind":{"type":"string","title":"Pending Post Kind","enum":["new","repeat","escalate","reopen","none"]},
  "lastGroupedAt":{"type":"integer","title":"Last Grouped At"}
 },
 "required":["fingerprint","automationId","state","totalCount","countSinceLastAck"],
 "indexes":[
  {"name":"uq_fingerprint","fields":[{"field":"fingerprint","direction":"asc"}],"unique":true},
  {"name":"ix_state","fields":[{"field":"state","direction":"asc"}]},
  {"name":"ix_automation","fields":[{"field":"automationId","direction":"asc"}]},
  {"name":"ix_needs_post","fields":[{"field":"needsPost","direction":"asc"}]}
 ]}},
{"tool":"create_object","args":{"name":"Sentinel Config","id":"sentinel_config","pluralName":"Sentinel Config","tags":["alert-monitoring"],
 "description":"Thresholds and settings every Sentinel flow reads at the start of a run. Change a value here, no redeploy needed.",
 "fields":{
  "key":{"type":"string","title":"Key"},
  "value":{"type":"string","title":"Value"},
  "description":{"type":"string","title":"Description"}
 },
 "required":["key","value"],
 "indexes":[{"name":"uq_key","fields":[{"field":"key","direction":"asc"}],"unique":true}]}},
{"tool":"create_object","args":{"name":"Sentinel Workflow Registry","id":"sentinel_workflow_registry","pluralName":"Sentinel Workflow Registry","tags":["alert-monitoring"],
 "description":"One row per automation Sentinel knows: owner, criticality, long-running expectations. Seeded from the platform, completed by humans in Slack.",
 "fields":{
  "automationId":{"type":"string","title":"Automation Id"},
  "name":{"type":"string","title":"Name"},
  "ownerUserId":{"type":"string","title":"Owner User Id (platform)"},
  "ownerName":{"type":"string","title":"Owner Name"},
  "ownerSlackId":{"type":"string","title":"Owner Slack Id"},
  "team":{"type":"string","title":"Team"},
  "criticality":{"type":"string","title":"Criticality","enum":["low","medium","high"]},
  "isLongRunning":{"type":"boolean","title":"Long Running"},
  "expectedMaxDurationMin":{"type":"integer","title":"Expected Max Duration (min)"},
  "active":{"type":"boolean","title":"Active"},
  "source":{"type":"string","title":"Source","enum":["seeded","auto","human"]},
  "lastFailureAt":{"type":"integer","title":"Last Failure At"},
  "notes":{"type":"string","title":"Notes"}
 },
 "required":["automationId"],
 "indexes":[{"name":"uq_automation","fields":[{"field":"automationId","direction":"asc"}],"unique":true}]}},
{"tool":"create_object","args":{"name":"Sentinel Incident","id":"sentinel_incident","pluralName":"Sentinel Incidents","tags":["alert-monitoring"],
 "description":"One row per platform-wide event: many automations failing together (storm, infra or dependency outage). Issues and runs attach to it.",
 "fields":{
  "type":{"type":"string","title":"Type","enum":["storm","infra","dependency"]},
  "errorClass":{"type":"string","title":"Error Class"},
  "state":{"type":"string","title":"State","enum":["open","resolved"]},
  "startedAt":{"type":"integer","title":"Started At"},
  "lastSeen":{"type":"integer","title":"Last Seen"},
  "resolvedAt":{"type":"integer","title":"Resolved At"},
  "affectedAutomationCount":{"type":"integer","title":"Affected Automations"},
  "affectedAutomationIds":{"type":"string","title":"Affected Automation Ids (comma separated)"},
  "runCount":{"type":"integer","title":"Run Count"},
  "sampleErrorMessage":{"type":"string","title":"Sample Error Message"},
  "slackChannelId":{"type":"string","title":"Slack Channel Id"},
  "slackRootTs":{"type":"string","title":"Slack Thread Ts"},
  "needsPost":{"type":"boolean","title":"Needs Slack Post"},
  "raisedToDevOpsAt":{"type":"integer","title":"Raised To DevOps At"}
 },
 "required":["type","state","startedAt"],
 "indexes":[{"name":"ix_state","fields":[{"field":"state","direction":"asc"}]}]}}
]}
