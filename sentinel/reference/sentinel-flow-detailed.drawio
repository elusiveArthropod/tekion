d=1;strokeColor=#b85450;dashPattern=1 3;" edge="1" parent="1" source="c30" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c72" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;dashPattern=1 3;" edge="1" parent="1" source="c30" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;dashPattern=1 3;" edge="1" parent="1" source="c30" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;dashPattern=1 3;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;dashPattern=1 3;exitX=1;exitY=0.2;exitDx=0;exitDy=0;entryX=0;entryY=0.9;entryDx=0;entryDy=0;" edge="1" parent="1" source="c30" target="c33"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1260" y="542"/><mxPoint x="1260" y="607"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 Failure pipeline (S1+S2)" id="2_Failure_pipeline_(S1+S2)"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Failure pipeline: what happens to every stored FailedRun (S1 Grouper + Decider, then S2 Poster)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Runs every 1-2 minutes over all FailedRun rows with state = new. Finance platform only. Everything on this page is code; the only LLM call is the orange box." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="1100" height="24" as="geometry"/></mxCell><mxCell id="c4" value="FailedRun, state = new" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="470" y="110" width="200" height="50" as="geometry"/></mxCell><mxCell id="c5" value="Normalise error text (strip IDs, numbers, timestamps, URLs).&lt;br&gt;fingerprint = hash(automationId + nodeId + exceptionClass + normalised message)&lt;br&gt;Classify error class: infra / auth / rate-limit / connector / application" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="300" height="95" as="geometry"/></mxCell><mxCell id="c6" value="Cascade?&lt;br&gt;another FailedRun shares rootExecutionId" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="320" width="260" height="90" as="geometry"/></mxCell><mxCell id="c7" value="Attach to the root run's Issue (deepest failed run in the chain).&lt;br&gt;Parent inherits root Issue status. (A3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="335" width="300" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Storm?&lt;br&gt;&amp;gt; N distinct automations failing in window, or infra error class" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="430" y="450" width="280" height="100" as="geometry"/></mxCell><mxCell id="c9" value="Find open Incident for this error class, else create one.&lt;br&gt;Attach FailedRun and Issue to Incident.&lt;br&gt;Not yet posted: URGENT top-level post, tag DevOps. (B1, B2, B6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="465" width="300" height="70" as="geometry"/></mxCell><mxCell id="c10" value="Posted as one Incident" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="475" width="160" height="50" as="geometry"/></mxCell><mxCell id="c11" value="Fingerprint matches an existing Issue?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="590" width="260" height="90" as="geometry"/></mxCell><mxCell id="c12" value="Create Issue: state = new, totalCount = 1, countSinceLastAck = 1.&lt;br&gt;Look up WorkflowRegistry; no owner: ask for one (C6).&lt;br&gt;Set state = pending_agent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="605" width="300" height="70" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Agent (C1)&lt;/b&gt;: read FailedRun.errorRaw, interpret, suspected cause.&lt;br&gt;Post the Issue message + question with options:&lt;br&gt;Expected · Known, link Atlas · Being worked on, give ETA · Needs devs · Not sure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="710" width="300" height="90" as="geometry"/></mxCell><mxCell id="c14" value="Issue: triaging&lt;br&gt;(awaiting answer)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="730" width="160" height="50" as="geometry"/></mxCell><mxCell id="c15" value="Attach FailedRun to Issue.&lt;br&gt;totalCount++, countSinceLastAck++, lastSeen = now" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="730" width="300" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Issue state = resolved?&lt;br&gt;(failure came back)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="830" width="260" height="90" as="geometry"/></mxCell><mxCell id="c17" value="Reopen: state = reopened, severity up, reopenCount++.&lt;br&gt;New top-level post, tag whoever fixed it. (F3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="845" width="300" height="60" as="geometry"/></mxCell><mxCell id="c18" value="Posted" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="850" width="120" height="50" as="geometry"/></mxCell><mxCell id="c19" value="Active suppression?&lt;br&gt;expected · tracked in Atlas · fix pending deploy · ETA · incident child · allowlisted" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="970" width="300" height="110" as="geometry"/></mxCell><mxCell id="c20" value="Silent: reaction on the alert only (mute / wrench / construction / hourglass).&lt;br&gt;Thread note on the Issue post with current count. (A2, A5, A6, C4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="995" width="300" height="60" as="geometry"/></mxCell><mxCell id="c21" value="Silent" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1200" y="1000" width="120" height="50" as="geometry"/></mxCell><mxCell id="c22" value="countSinceLastAck &amp;gt;= threshold?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="440" y="1120" width="260" height="90" as="geometry"/></mxCell><mxCell id="c23" value="Escalation L2 (E2): new top-level post, history + error summary, tag product + manager.&lt;br&gt;Issue state = escalated. FollowUp(level = L2)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="820" y="1135" width="300" height="60" as="geometry"/></mxCell><mxCell id="c24" value="Escalated" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry 