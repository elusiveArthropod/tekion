(dueAt, givenBy). Suppression(until = dueAt). Issue: suppressed. (C4)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="690" width="400" height="60" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c44"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="450"/><mxPoint x="1230" y="720"/></Array></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;Needs devs&lt;/b&gt;: Draft Atlas task text, ask confirm. On confirm: create Atlas task, AtlasLink, assign dev owner. Issue: tracked. (E1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="770" width="400" height="60" as="geometry"/></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c46"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1230" y="450"/><mxPoint x="1230" y="800"/></Array></mxGeometry></mxCell><mxCell id="c48" value="&lt;b&gt;Fixed&lt;/b&gt;: Issue: resolved. If it comes back: F3." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1260" y="850" width="400" h