28" as="geometry"/></mxCell><mxCell id="c17" value="Slack" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1618" y="1152" width="100" height="28" as="geometry"/></mxCell><mxCell id="c18" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1720" y="1152" width="34" height="28" as="geometry"/></mxCell><mxCell id="c19" value="End state" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1758" y="1152" width="100" height="28" as="geometry"/></mxCell><mxCell id="c20" value="Solid arrow = flow of work.  Dashed purple = data read/write.  Dotted red = heartbeat check.  R: = reads, W: = writes (listed inside each box)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1300" y="1200" width="560" height="36" as="geometry"/></mxCell><mxCell id="c21" value="Platform trigger:&lt;br&gt;&lt;b&gt;On Automation Run Failed&lt;/b&gt;&lt;br&gt;(real time, every failed run)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="180" width="210" height="90" as="geometry"/></mxCell><mxCell id="c22" value="Platform API:&lt;br&gt;in-progress runs" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="210" height="70" as="geometry"/></mxCell><mxCell id="c23" value="Platform API:&lt;br&gt;failed runs, last 15 min" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="210" height="70" as="geometry"/></mxCell><mxCell id="c24" value="Atlas board&lt;br&gt;(task status, assignee, PR)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="210" height="70" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;Notifier&lt;/b&gt; (one automation on the Finance platform)&lt;br&gt;1. trigger condition: isTestRun = false, self-excluded automationIds (A10, G4)&lt;br&gt;2. parse error[], strip headers, cap size&lt;br&gt;3. insert FailedRun (unique executionId; duplicate = drop, A4)&lt;br&gt;Nothing else. No Slack, no LLM." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="310" y="150" width="290" height="150" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;FailedRun&lt;/b&gt;&lt;br&gt;raw event,&lt;br&gt;append-only" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="650" y="170" width="120" height="110" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;S1 Grouper + Decider&lt;/b&gt;  every 1-2 min&lt;br&gt;fingerprint = automationId + nodeId + exceptionClass + normalised message&lt;br&gt;cascade by rootExecutionId (A3) · storm check (B6, B1) · classify error (B3, B4) · find or create Issue · counters · suppression check · threshold check&lt;br&gt;R: FailedRun, KnownIssue, Suppression, ETA, WorkflowRegistry&lt;br&gt;W: Issue, Incident, FailedRun.state, DecisionLog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="130" width="330" height="190" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Issue&lt;/b&gt;&lt;br&gt;one per fingerprint" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1210" y="170" width="120" height="110" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;S3 In-progress poll&lt;/b&gt;  every 5 min (existing automation)&lt;br&gt;duration vs WorkflowRegistry.expectedMaxDuration (D1-D4)&lt;br&gt;R: WorkflowRegistry · W: StuckRun, Issue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="380" width="330" height="100" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;S4 Reconciler + Heartbeat&lt;/b&gt;  every 5 min, independent&lt;br&gt;failed runs vs FailedRun.executionId: insert gaps (G5)&lt;br&gt;last-run time of Notifier, S1, S3, S5, Agent (G1, G2, G4)&lt;br&gt;R: FailedRun, Heartbeat · W: FailedRun, Heartbeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="520" width="330" height="110" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;S5 Lifecycle sweeper&lt;/b&gt;  hourly&lt;br&gt;expire suppressions and ETAs (F4, C4) · ETA chase (F1) · reminders and escalation ladder (E2, F6) · Atlas status and fix-deployed check (A5, A6, F3) · silence auto-close (F8)&lt;br&gt;R: Issue, Suppression, ETA, AtlasLink, FollowUp&lt;br&gt;W: Issue, FollowUp, Suppression, ETA, AtlasLink" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="830" y="680" width="330" height="150" as="geometry"/></mxCell><mxCell id="c32" value="&lt;b&gt;S2 Poster&lt;/b&gt;  (only writer to Slack)&lt;br&gt;one post per Issue or Incident, never per run · thread replies for repeats · reactions as status&lt;br&gt;unknown fingerprint: set Issue.state = pending_agent and call Agent&lt;br&gt;W: SlackPost, Issue.slackRootTs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1400" y="130" width="300" height="150" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Alert Agent&lt;/b&gt;  (Slack deployment, LLM)&lt;br&gt;Runs only for: (1) new fingerprint: read error, interpret, draft question with options (C1); (2) human thread reply or button: turn answer into record updates.&lt;br&gt;&lt;br&gt;Tools: get_issue · list_failed_runs · get_failed_run · get_registry · add_owner · set_known_issue · set_suppression · set_eta · link_atlas · create_atlas_task · post_thread · react&lt;br&gt;W: Issue, KnownIssue, Suppression, ETA, AtlasLink, WorkflowRegistry, DecisionLog" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="1400" y="400" width="300" height="230" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;#tekion-uat-alert&lt;/b&gt;&lt;br&gt;Issue posts · thread replies · reactions&lt;br&gt;URGENT top-level posts (B1, G1)&lt;br&gt;Escalation posts (E2, F3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1780" y="150" width="220" height="110" as="geometry"/></mxCell><mxCell id="c35" value="Product team&lt;br&gt;(FDSE + manager)&lt;br&gt;S0B23CF34HK" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1770" y="420" width="40" height="60" as="geometry"/></mxCell><mxCell id="c36" value="DevOps&lt;br&gt;S07S9ULDYE6" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1880" y="420" width="40" height="60" as="geometry"/></mxCell><mxCell id="c37" value="Dev owner&lt;br&gt;(from registry)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1770" y="560" width="40" height="60" as="geometry"/></mxCell><mxCell id="c38" value="Manager" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1880" y="560" width="40" height="60" as="geometry"/></mxCell><mxCell id="c39" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1740" y="400" width="230" height="260" as="geometry"/></mxCell><mxCell id="c40" value="Other data objects (see page 5 for fields)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="940" width="400" height="20" as="geometry"/></mxCell><mxCell id="c41" value="&lt;b&gt;Incident&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="970" width="120" height="70" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;StuckRun&lt;/b&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontFa