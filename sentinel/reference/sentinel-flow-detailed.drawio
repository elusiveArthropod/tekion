op=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c19" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c48" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c22" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c50" value="Rules that hold on every branch:&lt;br&gt;1. Suppress by fingerprint, never by automation: a new error on a suppressed automation is a new Issue (C7).&lt;br&gt;2. retryCount &amp;gt; 0 and the error class is transient: lower priority, still stored.&lt;br&gt;3. Execution count spike in one window: severity up (C5).&lt;br&gt;4. FailedRun.state goes new → grouped → posted. If the agent fails, state stays pending_agent and S4 reports it (G2)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="340" height="200" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="3 Issue states" id="3_Issue_states"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Issue lifecycle (one Issue per fingerprint)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="800" height="30" as="geometry"/></mxCell><mxCell id="c3" value="Boxes are Issue.state values. Arrows name who or what moves it and the case ID." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="55" width="800" height="24" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;new&lt;/b&gt;&lt;br&gt;created by S1&lt;br&gt;unknown fingerprint" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="180" height="70" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;pending_agent&lt;/b&gt;&lt;br&gt;waiting for LLM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="460" width="180" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;triaging&lt;/b&gt;&lt;br&gt;question posted,&lt;br&gt;awaiting answer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="460" y="200" width="180" height="70" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;suppressed&lt;/b&gt;&lt;br&gt;type: expected · fix pending deploy · ETA given · incident child · long-running allowlist&lt;br&gt;until: date, deploy, or incident close" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="420" y="560" width="320" height="90" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;tracked&lt;/b&gt;&lt;br&gt;Atlas task linked,&lt;br&gt;devs working" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="200" width="180" height="70" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;escalated&lt;/b&gt;&lt;br&gt;threshold crossed,&lt;br&gt;SLA or ETA missed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="200" width="180" height="70" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;resolved&lt;/b&gt;&lt;br&gt;human marked fixed, Atlas closed,&lt;br&gt;or silence for N days" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="800" width="240" height="70" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;reopened&lt;/b&gt;&lt;br&gt;same fingerprint back&lt;br&gt;after resolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Arial;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="800" width="180" height="70" as="geometry"/></mxCell><mxCell id="c12" value="S2 hands to Agent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"><mxPoint x="50" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c13" value="Agent posts question (C1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="15" as="offset"/></mxGeometry></mxCell><mxCell id="c14" value="Agent failed, S4 reports (G2)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;dashed=1;strokeColor=#b85450;dashPattern=1 3;exitX=0.15;exitY=0;exitDx=0;exitDy=0;entryX=0.15;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c4"><mxGeometry relative="1" as="geometry"><mxPoint x="-80" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c15" value="answer: known, Atlas linked (A5)&lt;br&gt;or needs devs, Atlas created (E1)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="c16" value="answer: expected (A2)&lt;br&gt;or being worked on + ETA (C4)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.55;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"><mxPoint x="95" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c17" value="suppression or ETA expired,&lt;br&gt;still failing (F4, L6)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.45;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c6"><mxGeometry relative="1" as="geometry"><mxPoint x="-90" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c18" value="no answer, count &amp;gt;= threshold (E2)&lt;br&gt;or SLA missed twice (F6)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c6" target="c9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="550" y="120"/><mxPoint x="1390" y="120"/></Array><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c19" value="fix PR merged, not deployed here (A6)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=0.1;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="898" y="470"/><mxPoint x="724" y="470"/></Array><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c20" value="Atlas stale + still failing (F1)&lt;br&gt;getting worse (E3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c8" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-22" as="offset"/></mxGeometry></mxCell><mxCell id="c21" value="answer with ETA or Atlas (L4)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c9" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1390" y="350"/><mxPoint x="1006" y="350"/></Array><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="c22" value="fix deployed, no failures since (A6)&lt;br&gt;or silence N days (F8)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"><mxPoint x="-20" y="20" as="offset"/></mxGeometry></mxCell><mxCell id="c23" value="Atlas closed, no failures since&lt;br&gt;or human marks fixed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c10"><mxGeometry relative="1" as="geometry"><mxPoint x="80" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c24" value="S1: fingerprint reappears (F3)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="c25" value="severity up, tag fixer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c9"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="c26" value="Not a transition: a different error on the same automation creates a new Issue (C7).&lt;br&gt;countSinceLastAck resets to 0 on any human answer; totalCount never resets.&lt;br&gt;Every transition writes a DecisionLog row (who, what, why, source)." style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;fontFamily=Arial;fontSize=11;align=left;verticalAlign=top;spacingLeft=6;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="80" y="680" width="500" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="4 Sweeper + agent replies" id="4_Sweeper_+_agent_replies"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="S5 Lifecycle sweeper (hourly) and Agent reply handling" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=18;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;S5 Lifecycle sweeper&lt;/b&gt;: for each Issue not in resolved, run the checks top to bottom. Thresholds live in one config object." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="560" height="30" as="geometry"/></mxCell><mxCell id="c4" value="Hourly tick" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="240" y="120" width="160" height="44" as="geometry"/></mxCell><mxCell id="c5" value="Suppression.until &amp;lt; now&lt;br&gt;or ETA.dueAt &amp;lt; now?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="210" width="240" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Still failing since? Re-raise with history (failures since ETA). Ask new ETA, stricter wording. ETA.missedCount++. Second miss: tag manager. (F4, C4, L6, L7)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="225" width="330" height="60" as="geometry"/></mxCell><mxCell id="c7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="Open question older than SLA?&lt;br&gt;(FollowUp unanswered)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="360" width="240" height="90" as="geometry"/></mxCell><mxCell id="c10" value="Remind in thread. Second miss: tag manager. (F6, L3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="375" width="330" height="60" as="geometry"/></mxCell><mxCell id="c11" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c5" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="tracked, no ETA, last ask older than interval?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="510" width="240" height="90" as="geometry"/></mxCell><mxCell id="c14" value="Ask product or dev owner for ETA in thread. FollowUp(type = eta_chase). Repeat each interval until answered. (F1, L5)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="525" width="330" height="60" as="geometry"/></mxCell><mxCell id="c15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c9" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Atlas task closed or fix PR deployed on Finance?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="660" width="240" height="90" as="geometry"/></mxCell><mxCell id="c18" value="Any FailedRun since deploy? none: state = resolved. some: reopen, tag fixer. (A6, F3)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="675" width="330" height="60" as="geometry"/></mxCell><mxCell id="c19" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c13" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="Atlas not updated for N days, still failing?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="810" width="240" height="90" as="geometry"/></mxCell><mxCell id="c22" value="Follow up with assignee on the Atlas task and in thread. (F1)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="825" width="330" height="60" as="geometry"/></mxCell><mxCell id="c23" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c17" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c21" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="No FailedRun for N days?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="960" width="240" height="90" as="geometry"/></mxCell><mxCell id="c26" value="Auto-close: state = resolved, thread note. (F8)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="975" width="330" height="60" as="geometry"/></mxCell><mxCell id="c27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c21" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="Incident open, no new failures for 30 min?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontFamily=Arial;fontSize=11;" vertex="1" parent="1"><mxGeometry x="200" y="1110" width="240" height="90" as="geometry"/></mxCell><mxCell id="c30" value="Post: incident looks over, suggest close. Child Issues keep their own state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Arial;fontSize=11;align=left;spacingLeft=6;spacingRight=6;verticalAlign=top;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="500" y="1125" width="330" height="60" as="geometry"/></mxCell><mxCell id="c31" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" parent="1" source="c25" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Arial;fontSize=10;endArrow=block;endFill=1;" edge="1" pa