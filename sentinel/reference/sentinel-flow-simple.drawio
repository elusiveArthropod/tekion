<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device"><diagram name="1 Main flow" id="1_Main_flow"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="What happens when an automation fails on the Finance platform" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Read top to bottom. Each band is one question. Diamonds are the checks, blue boxes are what the system does, orange is the only step where the AI agent is used, purple tags say which record gets written. Grey ovals are where this flow stops. Dashed purple boxes point to a separate flow (pages 2 and 3)." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1300" height="40" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Arial;fillColor=#f4f7fb;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="1680" height="620" as="geometry"/></mxCell><mxCell id="c5" value="1. Real or noise?" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="134" width="190" height="60" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Arial;fillColor=#f6f9f4;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1680" height="560" as="geometry"/></mxCell><mxCell id="c7" value="2. New or known?" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="774" width="190" height="60" as="geometry"/></mxCell><mxCell id="c8" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Arial;fillColor=#fbf7f1;" vertex="1" parent="1"><mxGeometry x="40" y="1340" width="1680" height="220" as="geometry"/></mxCell><mxCell id="c9" value="3. Who owns it?" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1354" width="190" height="60" as="geometry"/></mxCell><mxCell id="c10" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Arial;fillColor=#f8f3f8;" vertex="1" parent="1"><mxGeometry x="40" y="1580" width="1680" height="260" as="geometry"/></mxCell><mxCell id="c11" value="4. How bad?&lt;br&gt;&lt;span style='font-weight:normal;font-size:12px'&gt;impact × trend&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1594" width="190" height="60" as="geometry"/></mxCell><mxCell id="c12" value="" style="rounded=0;whiteSpace=wrap;html=1;strokeColor=none;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontFamily=Arial;fillColor=#fbf4f4;" vertex="1" parent="1"><mxGeometry x="40" y="1860" width="1680" height="420" as="geometry"/></mxCell><mxCell id="c13" value="5. Action" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=16;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="60" y="1874" width="190" height="60" as="geometry"/></mxCell><mxCell id="c14" value="An automation run fails&lt;br&gt;(platform trigger: On Automation Run Failed)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="500" y="150" width="260" height="60" as="geometry"/></mxCell><mxCell id="c15" value="Store the run as a &lt;b&gt;FailedRun&lt;/b&gt; record&lt;br&gt;(one record per executionId, with the error details)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="470" y="245" width="320" height="60" as="geometry"/></mxCell><mxCell id="c16" value="Writes: FailedRun" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="257" width="200" height="36" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="Test run from the builder?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="510" y="340" width="240" height="80" as="geometry"/></mxCell><mxCell id="c19" value="Noise. Ignore.&lt;br&gt;(trigger condition filters it out)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1540" y="355" width="220" height="50" as="geometry"/></mxCell><mxCell id="c20" value="Already stored this run?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="510" y="450" width="240" height="80" as="geometry"/></mxCell><mxCell id="c21" value="Noise. Drop the duplicate." style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1540" y="465" width="220" height="50" as="geometry"/></mxCell><mxCell id="c22" value="Caused by another failed run in the same chain?&lt;br&gt;(parent / child automation)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="470" y="560" width="320" height="90" as="geometry"/></mxCell><mxCell id="c23" value="Attach it to the &lt;b&gt;root cause's Issue&lt;/b&gt;.&lt;br&gt;It is counted there, not as a new problem." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="575" width="340" height="60" as="geometry"/></mxCell><mxCell id="c24" value="Writes: FailedRun.issueId, Issue.count" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="587" width="200" height="36" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="Many automations failing at the same time with platform errors?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="470" y="680" width="320" height="90" as="geometry"/></mxCell><mxCell id="c27" value="Real and urgent. Group everything into &lt;b&gt;one Incident&lt;/b&gt;.&lt;br&gt;Post URGENT in Slack, tag DevOps. Attach all runs." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="695" width="340" height="60" as="geometry"/></mxCell><mxCell id="c28" value="Writes: Incident, SlackPost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="685" width="200" height="36" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="Handled as one Incident" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1540" y="725" width="220" height="50" as="geometry"/></mxCell><mxCell id="c31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c15" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c20" target="c21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c36" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c20" target="c22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c22" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c22" target="c26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c39" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c26" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.9;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c27" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="Build the &lt;b&gt;fingerprint&lt;/b&gt; of the failure:&lt;br&gt;automation + failing node + error type + cleaned error text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="470" y="790" width="320" height="60" as="geometry"/></mxCell><mxCell id="c42" value="Is there already an &lt;b&gt;Issue&lt;/b&gt; with this fingerprint?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="470" y="885" width="320" height="90" as="geometry"/></mxCell><mxCell id="c43" value="&lt;b&gt;NEW problem.&lt;/b&gt; Create an Issue&lt;br&gt;(state = new, count = 1, first seen = now)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="900" width="340" height="60" as="geometry"/></mxCell><mxCell id="c44" value="Writes: Issue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="930" width="200" height="36" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c43" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c46" value="&lt;b&gt;KNOWN problem.&lt;/b&gt; Attach the run to the Issue.&lt;br&gt;count + 1, count since last answer + 1, last seen = now" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="470" y="1010" width="320" height="60" as="geometry"/></mxCell><mxCell id="c47" value="Writes: Issue.count, Issue.lastSeen" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1290" y="1022" width="200" height="36" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c46" target="c47"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c49" value="What state is the Issue in?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="510" y="1105" width="240" height="80" as="geometry"/></mxCell><mxCell id="c50" value="&lt;b&gt;Resolved earlier, now back.&lt;/b&gt;&lt;br&gt;Reopen it, raise severity." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="1040" width="340" height="50" as="geometry"/></mxCell><mxCell id="c51" value="Writes: Issue.state = reopened" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1530" y="1047" width="180" height="36" as="geometry"/></mxCell><mxCell id="c52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c50" target="c51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c53" value="&lt;b&gt;Suppressed&lt;/b&gt; (product said expected, dev is working on it, fix waiting for deploy, deadline given, part of an incident).&lt;br&gt;Stay silent: reaction on the Issue thread, note the new count." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="1120" width="340" height="80" as="geometry"/></mxCell><mxCell id="c54" value="Writes: SlackPost (thread note)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1360" y="1142" width="200" height="36" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c53" target="c54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c56" value="Silent. Nobody is pinged." style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="940" y="1230" width="240" height="50" as="geometry"/></mxCell><mxCell id="c57" value="Suppressions are set by humans answering in Slack: see &lt;b&gt;Flow B&lt;/b&gt; (page 2). They expire or get lifted by &lt;b&gt;Flow C&lt;/b&gt; (page 3)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;fontColor=#5e3a7a;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1280" y="1230" width="330" height="50" as="geometry"/></mxCell><mxCell id="c58" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c26" target="c41"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c59" value="then" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=0;exitY=0.8;exitDx=0;exitDy=0;entryX=0.8;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c23" target="c41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="623"/><mxPoint x="870" y="775"/><mxPoint x="726" y="775"/></Array><mxPoint x="14" y="-60" as="offset"/></mxGeometry></mxCell><mxCell id="c60" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c61" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c42" target="c43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c62" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c42" target="c46"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c46" target="c49"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c64" value="resolved" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c50"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="1145"/><mxPoint x="860" y="1065"/></Array><mxPoint x="0" y="-40" as="offset"/></mxGeometry></mxCell><mxCell id="c65" value="suppressed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c53"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="12" as="offset"/></mxGeometry></mxCell><mxCell id="c66" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c53" target="c56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c67" value="Is the automation in the &lt;b&gt;registry&lt;/b&gt; with an owner?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="470" y="1390" width="320" height="90" as="geometry"/></mxCell><mxCell id="c68" value="Add a registry row with no owner.&lt;br&gt;The agent will ask the product team who owns it, inside the Issue thread (answer comes back via &lt;b&gt;Flow B&lt;/b&gt;)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="1405" width="340" height="70" as="geometry"/></mxCell><mxCell id="c69" value="Writes: WorkflowRegistry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="1422" width="200" height="36" as="geometry"/></mxCell><mxCell id="c70" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c68" target="c69"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c71" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c43" target="c67"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1640" y="906"/><mxPoint x="1640" y="1330"/><mxPoint x="630" y="1330"/></Array></mxGeometry></mxCell><mxCell id="c72" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c67" target="c68"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c73" value="&lt;b&gt;Impact&lt;/b&gt; = how critical the automation is (from the registry).&lt;br&gt;&lt;b&gt;Trend&lt;/b&gt; = failures since the last human answer, execution spike, came back after a fix.&lt;br&gt;Severity = impact × trend." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="430" y="1630" width="400" height="80" as="geometry"/></mxCell><mxCell id="c74" value="Writes: Issue.severity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1300" y="1652" width="200" height="36" as="geometry"/></mxCell><mxCell id="c75" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c73" target="c74"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c76" value="Nobody answered and it keeps failing (count ≥ threshold),&lt;br&gt;or it came back after being fixed?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="470" y="1740" width="320" height="100" as="geometry"/></mxCell><mxCell id="c77" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c67" target="c73"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c68" target="c73"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1070" y="1560"/><mxPoint x="630" y="1560"/></Array></mxGeometry></mxCell><mxCell id="c79" value="open" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c49" target="c73"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="300" y="1145"/><mxPoint x="300" y="1670"/></Array><mxPoint x="-25" y="-200" as="offset"/></mxGeometry></mxCell><mxCell id="c80" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=0.95;exitY=1;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c50" target="c73"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1250" y="1615"/><mxPoint x="810" y="1615"/></Array></mxGeometry></mxCell><mxCell id="c81" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c73" target="c76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c82" value="Is this a new Issue?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="510" y="1910" width="240" height="80" as="geometry"/></mxCell><mxCell id="c83" value="&lt;b&gt;AI agent&lt;/b&gt; reads the error, writes a short summary with the likely cause, and asks the product team one question with buttons:&lt;br&gt;Expected · Known (Atlas link) · Being worked on (give a date) · Needs devs · Not sure&lt;br&gt;Posted as a &lt;b&gt;new thread&lt;/b&gt; in #alerts-finance-issues." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="410" y="2030" width="440" height="100" as="geometry"/></mxCell><mxCell id="c84" value="Writes: SlackPost, Issue.slackThread, Issue.state = triaging" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="110" y="2055" width="280" height="50" as="geometry"/></mxCell><mxCell id="c85" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c83" target="c84"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c86" value="Waiting for the product team's answer&lt;br&gt;(answer handled by Flow B)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="460" y="2210" width="300" height="60" as="geometry"/></mxCell><mxCell id="c87" value="Reply inside the existing Issue thread:&lt;br&gt;seen N times, first seen, latest run link." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="2030" width="340" height="60" as="geometry"/></mxCell><mxCell id="c88" value="Writes: SlackPost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1320" y="2042" width="150" height="36" as="geometry"/></mxCell><mxCell id="c89" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c87" target="c88"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c90" value="Posted. Thread stays the record." style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="950" y="2210" width="240" height="50" as="geometry"/></mxCell><mxCell id="c91" value="&lt;b&gt;ESCALATE.&lt;/b&gt; New top-level post in Slack with the full history, tag product team + manager, ask for a fix date." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="900" y="1910" width="340" height="70" as="geometry"/></mxCell><mxCell id="c92" value="Writes: SlackPost, FollowUp, Issue.state = escalated" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="940" y="1990" width="260" height="36" as="geometry"/></mxCell><mxCell id="c93" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c91" target="c92"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c94" value="Escalated. Flow C keeps&lt;br&gt;following up until answered." style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1420" y="1910" width="280" height="70" as="geometry"/></mxCell><mxCell id="c95" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c76" target="c82"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c96" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c76" target="c91"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c97" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c82" target="c83"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c98" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c82" target="c87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c99" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c83" target="c86"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c100" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c87" target="c90"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c101" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c91" target="c94"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="2 Flow B human answer" id="2_Flow_B_human_answer"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Flow B: a human answers in the Issue thread" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="c3" value="This is where the system learns. Every answer is turned into a record, so the next time the same failure happens, the main flow (page 1, band 2) already knows what to do." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Someone clicks a button or replies in an Issue thread&lt;br&gt;in #alerts-finance-issues" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="320" height="60" as="geometry"/></mxCell><mxCell id="c5" value="Find which Issue this thread belongs to&lt;br&gt;(thread id → SlackPost → Issue). Not one of ours: ignore." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="100" y="230" width="320" height="60" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;AI agent&lt;/b&gt; reads the answer.&lt;br&gt;Button = exact. Free text = interpreted and echoed back so a wrong reading is visible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="100" y="330" width="320" height="70" as="geometry"/></mxCell><mxCell id="c7" value="What did they say?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="160" y="440" width="200" height="80" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="&lt;b&gt;Expected&lt;/b&gt;: This failure is expected. Store the reason. Issue goes to &lt;b&gt;suppressed&lt;/b&gt;; future runs stay silent." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="560" width="520" height="65" as="geometry"/></mxCell><mxCell id="c12" value="Writes: KnownIssue, Suppression, Issue.state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="574" width="260" height="36" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="480"/><mxPoint x="480" y="592"/></Array></mxGeometry></mxCell><mxCell id="c15" value="&lt;b&gt;Known (Atlas link)&lt;/b&gt;: Already tracked. Link the Atlas task. Issue goes to &lt;b&gt;tracked&lt;/b&gt;. No date yet: Flow C will ask for one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="655" width="520" height="65" as="geometry"/></mxCell><mxCell id="c16" value="Writes: AtlasLink, Issue.state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="669" width="260" height="36" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c15"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="480"/><mxPoint x="480" y="687"/></Array></mxGeometry></mxCell><mxCell id="c19" value="&lt;b&gt;Being worked on + date&lt;/b&gt;: Client or FDSE is fixing it. Store the date. Silent until then; after the date it comes back with history." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="750" width="520" height="65" as="geometry"/></mxCell><mxCell id="c20" value="Writes: ETA, Suppression (until date), Issue.state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="764" width="260" height="36" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c19"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="480"/><mxPoint x="480" y="782"/></Array></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Needs devs&lt;/b&gt;: Agent drafts the Atlas task text, asks for confirmation, then creates the task for the dev owner. Issue goes to &lt;b&gt;tracked&lt;/b&gt;." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="845" width="520" height="65" as="geometry"/></mxCell><mxCell id="c24" value="Writes: AtlasLink, Issue.state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="859" width="260" height="36" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c23"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="480"/><mxPoint x="480" y="877"/></Array></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Fixed&lt;/b&gt;: Issue goes to &lt;b&gt;resolved&lt;/b&gt;. If the same failure comes back, the main flow reopens it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="940" width="520" height="65" as="geometry"/></mxCell><mxCell id="c28" value="Writes: Issue.state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="954" width="260" height="36" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c27" target="c28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c27"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="480"/><mxPoint x="480" y="972"/></Array></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;Owner is X&lt;/b&gt;: Record the owner for this automation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="1035" width="520" height="65" as="geometry"/></mxCell><mxCell id="c32" value="Writes: WorkflowRegistry.owner, OwnerDirectory" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="1049" width="260" height="36" as="geometry"/></mxCell><mxCell id="c33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c31" target="c32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="480"/><mxPoint x="480" y="1067"/></Array></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;Not sure&lt;/b&gt;: Tag the manager in the thread. Issue stays as it is." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="560" y="1130" width="520" height="65" as="geometry"/></mxCell><mxCell id="c36" value="Writes: FollowUp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="1144" width="260" height="36" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c35" target="c36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="480"/><mxPoint x="480" y="1162"/></Array></mxGeometry></mxCell><mxCell id="c39" value="Always: log who decided what and why · reset 'failures since last answer' to 0 · tick the reply · confirm in one line" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="100" y="1260" width="980" height="50" as="geometry"/></mxCell><mxCell id="c40" value="Writes: DecisionLog, Issue.countSinceLastAck" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1140" y="1267" width="260" height="36" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c39" target="c40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c39"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="1230"/></Array></mxGeometry></mxCell><mxCell id="c43" value="Done" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="220" y="1350" width="120" height="44" as="geometry"/></mxCell><mxCell id="c45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="c39" target="c44"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="3 Flow C follow-up + background" id="3_Flow_C_follow-up_+_background"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Flow C: hourly follow-up, and the background flows" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=20;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="34" as="geometry"/></mxCell><mxCell id="c3" value="Flow C runs every hour over all open Issues. It is what stops things being forgotten: it chases dates, reminds people, and closes Issues that went quiet. It never reads Slack; it reads the records." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1100" height="40" as="geometry"/></mxCell><mxCell id="c4" value="Every hour" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="200" y="120" width="160" height="44" as="geometry"/></mxCell><mxCell id="c5" value="Date promised has passed and it is still failing?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="160" y="200" width="240" height="90" as="geometry"/></mxCell><mxCell id="c6" value="Re-raise in the thread with history (failures since the date). Ask for a new date, firmer tone. Second miss: tag the manager." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="460" y="210" width="420" height="70" as="geometry"/></mxCell><mxCell id="c7" value="Writes: ETA.missed, FollowUp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="920" y="227" width="220" height="36" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c4" target="c5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="Question to product unanswered for longer than the SLA?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="160" y="340" width="240" height="90" as="geometry"/></mxCell><mxCell id="c12" value="Remind in the thread. Second reminder tags the manager." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="460" y="350" width="420" height="70" as="geometry"/></mxCell><mxCell id="c13" value="Writes: FollowUp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="920" y="367" width="220" height="36" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c12" target="c13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c5" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="Tracked by devs but no date given?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="160" y="480" width="240" height="90" as="geometry"/></mxCell><mxCell id="c18" value="Ask the dev owner for a date. Repeat every interval until answered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="460" y="490" width="420" height="70" as="geometry"/></mxCell><mxCell id="c19" value="Writes: FollowUp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="920" y="507" width="220" height="36" as="geometry"/></mxCell><mxCell id="c20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c21" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c11" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="Atlas task closed or fix deployed on Finance?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="160" y="620" width="240" height="90" as="geometry"/></mxCell><mxCell id="c24" value="Any failures since? None: Issue &lt;b&gt;resolved&lt;/b&gt;. Some: reopen and tag whoever fixed it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="460" y="630" width="420" height="70" as="geometry"/></mxCell><mxCell id="c25" value="Writes: AtlasLink, Issue.state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="920" y="647" width="220" height="36" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c24" target="c25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c17" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c23" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="No failures at all for N days?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="160" y="760" width="240" height="90" as="geometry"/></mxCell><mxCell id="c30" value="Close the Issue quietly, note in thread. It reopens by itself if the failure returns." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="460" y="770" width="420" height="70" as="geometry"/></mxCell><mxCell id="c31" value="Writes: Issue.state = resolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="920" y="787" width="220" height="36" as="geometry"/></mxCell><mxCell id="c32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c30" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c23" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c29" target="c30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="Done until next hour" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="200" y="900" width="160" height="44" as="geometry"/></mxCell><mxCell id="c36" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;" edge="1" parent="1" source="c29" target="c35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c37" value="Background flows (code only, no AI, no decisions about failures)" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=13;fontStyle=1;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1220" y="120" width="600" height="24" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;Flow D: safety checks, every 5 min&lt;/b&gt;&lt;br&gt;Compares the platform's failed-run list with our FailedRun records and stores anything the trigger missed. Checks that the trigger, the main flow, Flow C and the agent have all run recently. If one is silent: URGENT post, tag DevOps." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;fontColor=#5e3a7a;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1220" y="160" width="460" height="120" as="geometry"/></mxCell><mxCell id="c39" value="Writes: FailedRun (gaps), Heartbeat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1700" y="200" width="200" height="36" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c38" target="c39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c41" value="&lt;b&gt;Flow E: stuck runs, every 5 min&lt;/b&gt;&lt;br&gt;Looks at runs still in progress. Compares against the expected maximum duration stored in the registry. Unknown automation: ask product if this is normal and store the answer. Over the limit: raise as an Issue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;fontColor=#5e3a7a;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1220" y="340" width="460" height="120" as="geometry"/></mxCell><mxCell id="c42" value="Writes: StuckRun, WorkflowRegistry, Issue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1700" y="380" width="200" height="36" as="geometry"/></mxCell><mxCell id="c43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c41" target="c42"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c44" value="&lt;b&gt;Flow F: Slack posting (used by every flow)&lt;/b&gt;&lt;br&gt;The one place that writes to Slack. One post per Issue or Incident, never per run. Stores the thread id so replies can be matched back." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;dashed=1;fontSize=11;fontColor=#5e3a7a;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1220" y="520" width="460" height="120" as="geometry"/></mxCell><mxCell id="c45" value="Writes: SlackPost, Issue.slackThread" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=4;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1700" y="560" width="200" height="36" as="geometry"/></mxCell><mxCell id="c46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;endArrow=block;endFill=1;fontFamily=Arial;dashed=1;strokeColor=#9673a6;endArrow=none;" edge="1" parent="1" source="c44" target="c45"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>