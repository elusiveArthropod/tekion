  codes.add(c)\n    names[c] = (p.department ?: '').toString()\n  }\n}\n\nif (codes.isEmpty() && !isAdmin) {\n  return [\n    allowed: false,\n    codesCsv: '',\n    message: 'Department balances are available to department heads and admins only. If you believe you should have access, please contact your administrator or raise a concern for further review.'\n  ]\n}\n\nif (codes.isEmpty() && isAdmin) {\n  def own = (ownCode ?: '').toString().trim()\n  if (own) codes.add(own)\n}\n\nif (codes.isEmpty()) {\n  return [\n    allowed: false,\n    codesCsv: '',\n    message: 'No department is associated with your profile, so I can\\'t calculate a department balance. Please contact your administrator to update your profile.'\n  ]\n}\n\ndef csv = codes.collect { \"'\" + it.replace(\"'\", \"''\") + \"'\" }.join(',')\nreturn [allowed: true, codesCsv: csv, departments: names, message: '']\n","compile_static":false,"captureStdOutput":false,"parameters":{"myEmail":"{{ n_vVK5Y.outputs.properties.email }}","adminFlag":"{{ n_LoVGL.outputs.properties.isAdmin }}","ownCode":"{{ n_LoVGL.outputs.properties.costCenterID }}","headedRows":{"source":"{{ n_Gyzle.outputs.objects }}","ua:type":"mappedArray","items":"{{ n_Gyzle.outputs.objects[0].properties }}"}}},"skip":false,"subTitle":"Code","title":"Execute Groovy code","type":"ACTION"},{"context":{"appName":"if_else","resourceVersion":26,"resourceName":"if_else_condition","type":"APPLICATION"},"debug":false,"dirty":false,"fallbackMode":"STOP","groupId":"n_NJTsA@_Mefc1-1@y","id":"n_JAFjj","index":9,"inputs":{"filters":[{"property":"{{ n_Q0yTc.outputs.result.allowed }}","filter":{"operator":"EQUAL","value":"false"}}],"operator":"AND"},"skip":false,"subTitle":"Condition","title":"Condition","type":"IF_ELSE"},{"context":{"appName":"callables","resourceVersion":472,"resourceName":"callables_return_to_automation","type":"APPLICATION"},"debug":false,"dirty":false,"fallbackMode":"STOP","groupId":"n_JAFjj@n_NJTsA@_Mefc1-1@y@y","id":"n_kAiIz","index":